# APP_URL: The public URL where this application is hosted.
APP_URL="http://localhost:3000"

# NODE_ENV & PORT: Server runtime configuration.
NODE_ENV="development"
PORT="3000"

# JWT_SECRET: Signing secret for session authentication tokens (MUST override in production).
JWT_SECRET="CHANGE_ME_RESTO_MAX_JWT_SECRET"

# DATABASE_CLIENT: "sqlite" (default single-node WAL) or "pg" (PostgreSQL multi-instance production).
DATABASE_CLIENT="sqlite"
DATABASE_PATH="./data/restomax.db"
# DATABASE_URL: Required when DATABASE_CLIENT="pg" (e.g. postgres://user:pass@host:5432/restomax)
DATABASE_URL=""
DATABASE_SSL="false"
DB_POOL_MIN="2"
DB_POOL_MAX="20"

# MULTI-INSTANCE / PUBSUB: Unique server instance identifier & optional PostgreSQL/Redis channel.
INSTANCE_ID="restomax-node-1"
REDIS_URL=""

# PAYMENT_MODE: TEST or LIVE (always keep TEST unless explicitly validated).
PAYMENT_MODE="TEST"
PAYDUNYA_WEBHOOK_SECRET=""

# SMTP_* : Production SMTP server settings for automated critical stock email alerts.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Resto’MAX Alertes <alertes@restomax.ci>"
