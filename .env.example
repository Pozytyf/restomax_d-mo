# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Signing secret for session authentication tokens (override in production).
JWT_SECRET="CHANGE_ME_RESTO_MAX_JWT_SECRET"

# DATABASE_PATH: SQLite database file path.
DATABASE_PATH="./data/restomax.db"

# PAYMENT_MODE: TEST or LIVE (always keep TEST unless explicitly validated).
PAYMENT_MODE="TEST"

# PAYDUNYA_WEBHOOK_SECRET: Optional webhook verification secret for PayDunya callbacks.
PAYDUNYA_WEBHOOK_SECRET=""

# SMTP_* : Optional SMTP server settings for automated stock critical email alerts.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="alertes@restomax.ci"
